# ---------- Gemini ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Free tier: each model has its own small daily quota; these are tried in order when one runs out
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview,gemini-3.6-flash,gemini-3.5-flash
# Optional: stronger model for the simulation judge only (tests)
GEMINI_JUDGE_MODEL=
# INR per 1M tokens, for the dashboard cost panel (0 on the free tier)
GEMINI_INPUT_PRICE=
GEMINI_OUTPUT_PRICE=

# ---------- Agent behaviour ----------
CALLBACK_WINDOW_BUSINESS_HOURS=within an hour
CALLBACK_WINDOW_AFTER_HOURS=by eleven a.m. on the next working day
# Leave empty = agent states no price numbers at all. If set, the agent may say it
# once, verbatim, only after the caller has asked about price 3+ times.
APPROVED_PRICE_BAND_TEXT=
# Optional office variant; said only from the caller's 4th price ask, once, verbatim
APPROVED_PRICE_BAND_TEXT_OFFICE=

# ---------- Vaani ----------
VAANI_API_KEY=
VAANI_API_BASE_URL=
VAANI_WEBHOOK_SECRET=
VAANI_COST_PER_MIN=

# ---------- Neon ----------
DATABASE_URL=

# ---------- HubSpot ----------
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_QUALIFIED=
HUBSPOT_STAGE_NEEDS_REVIEW=
HUBSPOT_STAGE_DESIGNER_CONTACTED=
HUBSPOT_STAGE_CONSULT_BOOKED=

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
SEND_NEEDS_REVIEW=true

# ---------- Cal.com ----------
CALCOM_WEBHOOK_SECRET=
CALCOM_LINK=

# ---------- App ----------
APP_BASE_URL=
CRON_SECRET=
# Fixed monthly costs in INR, JSON e.g. {"vaani_number":500,"vercel":0}
FIXED_MONTHLY_COSTS_JSON={}
DRY_RUN=true
